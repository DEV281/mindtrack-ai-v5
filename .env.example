# ============================================================
# MindTrack AI v5 — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ── Required ──────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here           # Get from console.groq.com
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/mindtrack
DATABASE_URL_SYNC=postgresql://user:pass@localhost:5432/mindtrack
REDIS_URL=redis://localhost:6379
SECRET_KEY=change-me-run-openssl-rand-hex-32

# ── Optional — Email (for OTP verification) ──────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ── Optional — Google OAuth2 ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Optional — reCAPTCHA ─────────────────────────────────────
RECAPTCHA_SECRET_KEY=

# ── Optional — Kaggle (for dataset downloads) ────────────────
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── Optional — Frontend URL (CORS) ───────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Optional — Model Paths ───────────────────────────────────
PRETRAINED_DIR=./data/pretrained
REAL_MODEL_PATH=./data/pretrained/vit_fer2013_best.pt

# ── App Settings ─────────────────────────────────────────────
APP_ENV=development
DEBUG=true
DEMO_MODE=true
DEMO_EMAIL=demo@mindtrack.ai
DEMO_PASSWORD=Demo@1234

# ── AI / Safety Thresholds ───────────────────────────────────
CRISIS_STRESS_THRESHOLD=85
CRISIS_ANXIETY_THRESHOLD=80
MAX_CONVERSATION_HISTORY=30
SESSION_RATE_LIMIT_MESSAGES=60
